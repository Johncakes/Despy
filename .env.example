# ──────────────────────────────────────────────────────────────────────
# despy 환경 변수 예시 — 복사해서 .env.local 로 사용하세요.
# (.env.local 은 .gitignore 에 의해 커밋되지 않습니다)
# ──────────────────────────────────────────────────────────────────────

# ── AI 에이전트 (Gemini) — /api/agent 에서 사용 ─────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
# 키는 서버(라우트 핸들러)에서만 사용되며 클라이언트에 노출되지 않습니다.
GEMINI_API_KEY=""
# (대안 키 이름도 인식합니다: GOOGLE_GENERATIVE_AI_API_KEY)
#
# 알고리즘·웹 과제 채점 모두 이 키로 동작합니다(/api/grade, /api/grade/algorithm).
# 코드 실행 채점(Judge0)은 제거되었고 채점은 AI 정성 판정으로 수행됩니다(P5).

# ── MongoDB (인증·사용자 영속 — 실서비스 전환) ──────────────────────────
# 사용자(users) 컬렉션 영속에 사용합니다. 인증/관리자 API와 시드 스크립트에서 필요.
MONGODB_URI="mongodb://localhost:27017/despy"
# 선택: 사용할 DB 이름(기본값 'despy'). URI 경로와 별개로 지정하고 싶을 때만.
# MONGODB_DB_NAME="despy"

# ── 세션 JWT (인증) ────────────────────────────────────────────────────
# 세션 토큰 서명 비밀키. 길고 무작위한 값으로 설정하세요(예: openssl rand -base64 48).
# 절대 커밋하지 말 것 — 유출 시 모든 세션을 위조할 수 있습니다.
JWT_SECRET=""

# ── 최초 관리자 시드 (npm run seed:admin 에서만 사용) ──────────────────────
# 최초 1명의 관리자 계정을 만들 때 사용합니다. 생성 후에는 비워도 됩니다.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="관리자"
